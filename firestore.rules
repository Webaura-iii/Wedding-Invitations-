rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // One document per public slug: invitations/{slug}.
    // Public guests can fetch a known slug only when it is published.
    // The admin UI should use authenticated owner-scoped queries.
    match /invitations/{slug} {
      allow get: if resource.data.status == 'published'
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);

      allow list: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.slug == slug
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.keys().hasAll([
          'ownerUid', 'slug', 'status', 'groom', 'bride',
          'nameOrder', 'initials', 'eventDateTimeISO', 'timeZone',
          'nikah', 'createdAt', 'updatedAt'
        ]);

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.slug == slug
        && request.resource.data.status in ['draft', 'published', 'archived'];

      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // Deny all unspecified collections by default.
  }
}
